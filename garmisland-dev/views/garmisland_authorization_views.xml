<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="garm_authorize_page" name="OAuth Authorization Page">
        <t t-call="web.login_layout">
            <t t-set="html_data" t-value="{'lang': lang}"/>
            <div class="o_oauth_authorize d-flex align-items-center justify-content-center" style="min-height: 100vh; background: #f4f6f8;">
                <div class="container" style="max-width: 460px;">
                    <div class="card border-0 shadow-lg rounded-4">
                        <div class="card-body p-4 p-md-5">

                            <!-- App icon / avatar -->
                            <div class="text-center mb-3">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10" style="width: 100px; height: 64px; background-color:black!important; border-radius:10px!important;">
                                    
                                    <img src="https://garmisland.com/cdn/shop/files/garmlogowhite.png?v=1714559105&amp;width=380" alt="" style="width: 100%; height: 100%; object-fit: contain;"/>
                                    
                                </div>
                            </div>

                            <!-- Title -->
                            <h4 class="text-center fw-bold mb-1">
                                Garm Island wants to access your account
                            </h4>
                            <p class="text-center text-muted small mb-4">
                                Signed in as <strong t-out="request.env.user.email or request.env.user.login"/>
                            </p>

                            <!-- Permissions requested -->
                            <div class="bg-light rounded-3 p-3 mb-4">
                                <p class="fw-semibold small mb-2">This app will be able to:</p>
                                <ul class="list-unstyled mb-0 small">
                                    <t t-if="scopes">
                                        <t t-foreach="scopes" t-as="scope">
                                            <li class="d-flex align-items-start mb-2">
                                                <i class="fa fa-check-circle text-success mt-1 me-2"/>
                                                <span t-out="scope"/>
                                            </li>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <li class="d-flex align-items-start">
                                            <i class="fa fa-check-circle text-success mt-1 me-2"/>
                                            <span>View your basic Odoo account information</span>
                                        </li>
                                    </t>
                                </ul>
                            </div>

                            <p class="text-muted text-center" style="font-size: 12px;">
                                <i class="fa fa-lock me-1"/>
                                By approving, you allow this application to use your data according to its own terms and privacy policy. You can revoke access at any time from your account settings.
                            </p>

                            <!-- Approve form -->
                            <form action="/garm/oauth/approve" method="POST" class="mt-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="client_id" t-att-value="client.client_id"/>
                                <input type="hidden" name="redirect_uri" t-att-value="redirect_uri"/>
                                <input type="hidden" name="store_id" t-att-value="store_id"/>
                                <input type="hidden" name="state" t-att-value="state"/>

                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary btn-lg rounded-3">
                                        Approve Access
                                    </button>
                                </div>
                            </form>

                            <!-- Denial form -->
                            <form action="/garm/oauth/deny" method="POST" class="mt-2">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="redirect_uri" t-att-value="redirect_uri"/>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-outline-secondary rounded-3">
                                        Cancel
                                    </button>
                                </div>
                            </form>

                        </div>
                    </div>

                    <p class="text-center text-muted small mt-3">
                        <t t-out="request.env.company.name"/>
                    </p>
                </div>
            </div>
        </t>
    </template>
</odoo>